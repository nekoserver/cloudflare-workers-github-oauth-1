# nekorootトンネルのingress設定テンプレート。__NEKOROOT_HOSTNAME__は
# entrypoint.shがNEKOROOT_HOSTNAME環境変数で置換してから使う。
# nekorootはmygwでSSH(/ssh → 2222)とApache(TLS → 8443)を受ける。
# CFC用トンネルの接続トークンとは分離する(2026-10-21ユーザー指定)。
# WebSocketはcloudflaredが自動で中継するため特別な設定は不要。SSE用に
# disableChunkedEncodingを明示的にfalse(既定)にし、長時間接続向けに
# keepAlive系のタイムアウトを伸ばしている。
originRequest:
  noTLSVerify: true
  disableChunkedEncoding: false
  connectTimeout: 30s
  tcpKeepAlive: 30s
  keepAliveConnections: 100
  keepAliveTimeout: 90s

ingress:
  - hostname: __NEKOROOT_HOSTNAME__
    path: ^/ssh
    service: ssh://127.0.0.1:2222
  - hostname: __NEKOROOT_HOSTNAME__
    service: https://127.0.0.1:8443
    originRequest:
      noTLSVerify: true
  - service: http_status:404
